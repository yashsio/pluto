+/* IPC for status bars (pluto-bar). */
+#define MAX_CLIENTS 8
+#define LINE_MAX_LEN 512
+#define SNAPSHOT_MAX 32768
+
+struct IpcClient {
+	int fd;
+	char line[LINE_MAX_LEN];
+	size_t line_len;
+};
+
+static struct IpcClient ipc_clients[MAX_CLIENTS];
+static int ipc_listen_fd = -1;
+static char ipc_socket_path[256];
+
+static void
+ipc_close_client(struct IpcClient *c)
+{
+	if (c->fd < 0)
+		return;
+	close(c->fd);
+	c->fd = -1;
+	c->line_len = 0;
+}
+
+static int
+ipc_make_socket_path(char *buf, size_t size)
+{
+	const char *runtime = getenv("XDG_RUNTIME_DIR");
+	const char *display = getenv("WAYLAND_DISPLAY");
+	char safe[128];
+	size_t i, j = 0;
+
+	if (runtime == NULL || runtime[0] == '\0')
+		runtime = "/tmp";
+	if (display == NULL || display[0] == '\0')
+		display = "wayland-0";
+
+	for (i = 0; display[i] != '\0' && j < sizeof(safe) - 1; i++) {
+		unsigned char ch = display[i];
+		if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
+				|| (ch >= '0' && ch <= '9')
+				|| ch == '-' || ch == '_' || ch == '.')
+			safe[j++] = ch;
+		else
+			safe[j++] = '_';
+	}
+	safe[j] = '\0';
+
+	int n = snprintf(buf, size, "%s/pluto-%s.sock", runtime, safe);
+	return n < 0 || (size_t)n >= size ? -1 : 0;
+}
+
+static size_t
+ipc_append(char *buf, size_t cap, size_t len, const char *fmt, ...)
+{
+	va_list ap;
+	int n;
+
+	if (len >= cap)
+		return cap;
+
+	va_start(ap, fmt);
+	n = vsnprintf(buf + len, cap - len, fmt, ap);
+	va_end(ap);
+
+	if (n < 0)
+		return len;
+	if ((size_t)n >= cap - len)
+		return cap;
+	return len + n;
+}
+
+static void
+ipc_copy_title(char *dst, size_t size, const char *src)
+{
+	size_t i;
+
+	if (src == NULL)
+		src = "";
+	for (i = 0; src[i] != '\0' && i + 1 < size; i++)
+		dst[i] = (src[i] == '\n' || src[i] == '\r') ? ' ' : src[i];
+	dst[i] = '\0';
+}
+
+static void
+ipc_build_snapshot(char *buf, size_t cap)
+{
+	Monitor *m;
+	Client *c;
+	size_t len = 0;
+
+	len = ipc_append(buf, cap, len, "begin\n");
+
+	wl_list_for_each(m, &monitors, link) {
+		unsigned int occupied = 0;
+		unsigned int focused_tags = m->tagset[m->seltags] & TAGMASK;
+		const char *layout = (m->lt[m->sellt] != NULL
+				&& m->lt[m->sellt]->symbol != NULL)
+			? m->lt[m->sellt]->symbol : "-";
+		char title[256];
+		int focused = m == selmon;
+		int floating = m->sel != NULL && m->sel->isfloating;
+
+		wl_list_for_each(c, &clients, link)
+			if (c->mon == m)
+				occupied |= c->tags & TAGMASK;
+
+		ipc_copy_title(title, sizeof(title),
+				m->sel != NULL ? m->sel->title : NULL);
+
+		len = ipc_append(buf, cap, len,
+				"monitor %s %x %x %s %d %d %s\n",
+				m->name[0] != '\0' ? m->name : "?",
+				focused_tags, occupied, layout,
+				focused, floating, title);
+	}
+
+	ipc_append(buf, cap, len, "end\n");
+}
+
+static void
+ipc_send_to(struct IpcClient *cl, const char *buf, size_t len)
+{
+	size_t off = 0;
+
+	if (cl->fd < 0)
+		return;
+	while (off < len) {
+		ssize_t n = send(cl->fd, buf + off, len - off, MSG_NOSIGNAL);
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			ipc_close_client(cl);
+			return;
+		}
+		off += (size_t)n;
+	}
+}
+
+static void
+ipc_broadcast_snapshot(int force)
+{
+	static char last[SNAPSHOT_MAX];
+	static size_t last_len;
+	char snapshot[SNAPSHOT_MAX];
+	size_t len;
+
+	ipc_build_snapshot(snapshot, sizeof(snapshot));
+	snapshot[sizeof(snapshot) - 1] = '\0';
+	len = strlen(snapshot);
+
+	if (!force && len == last_len && len <= sizeof(last)
+			&& (len == 0 || memcmp(snapshot, last, len) == 0))
+		return;
+	if (len <= sizeof(last)) {
+		memcpy(last, snapshot, len);
+		last_len = len;
+	} else {
+		last_len = 0;
+	}
+
+	for (size_t i = 0; i < MAX_CLIENTS; i++)
+		ipc_send_to(&ipc_clients[i], snapshot, len);
+}
+
+static void
+ipc_update(void)
+{
+	if (ipc_listen_fd < 0)
+		return;
+	ipc_broadcast_snapshot(0);
+}
+
+static Monitor *
+ipc_monitor_by_name(const char *name)
+{
+	Monitor *m;
+
+	wl_list_for_each(m, &monitors, link)
+		if (strcmp(m->name, name) == 0)
+			return m;
+
+	return NULL;
+}
+
+static void
+ipc_command_view(const char *name, unsigned int t)
+{
+	Monitor *m = ipc_monitor_by_name(name);
+
+	if (m == NULL)
+		return;
+
+	t &= TAGMASK;
+	if (t == 0)
+		return;
+
+	selmon = m;
+	if (m->tagset[m->seltags] == t) {
+		manage_dirty();
+		ipc_update();
+		return;
+	}
+
+	m->tagset[m->seltags] = t;
+	m->sel = first_visible(m);
+	focus(m->sel);
+	manage_dirty();
+	ipc_update();
+}
+
+static void
+ipc_handle_command(char *line)
+{
+	char name[64];
+	unsigned int t;
+	char extra;
+
+	if (sscanf(line, "view %63s %x %c", name, &t, &extra) == 2)
+		ipc_command_view(name, t);
+	else if (strcmp(line, "refresh") == 0)
+		ipc_update();
+}
+
+static void
+ipc_read_client(struct IpcClient *c)
+{
+	char buf[1024];
+
+	for (;;) {
+		ssize_t n = read(c->fd, buf, sizeof(buf));
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			if (errno == EAGAIN || errno == EWOULDBLOCK)
+				return;
+			ipc_close_client(c);
+			return;
+		}
+		if (n == 0) {
+			ipc_close_client(c);
+			return;
+		}
+
+		for (ssize_t i = 0; i < n; i++) {
+			if (buf[i] == '\n') {
+				c->line[c->line_len] = '\0';
+				if (c->line_len > 0
+						&& c->line[c->line_len - 1] == '\r')
+					c->line[--c->line_len] = '\0';
+				if (c->line_len > 0)
+					ipc_handle_command(c->line);
+				c->line_len = 0;
+			} else if (c->line_len < sizeof(c->line) - 1) {
+				c->line[c->line_len++] = buf[i];
+			} else {
+				c->line_len = 0;
+			}
+		}
+	}
+}
+
+static int
+ipc_add_pollfds(struct pollfd *fds, int nfds, int max)
+{
+	if (ipc_listen_fd < 0)
+		return nfds;
+
+	if (nfds < max) {
+		fds[nfds].fd = ipc_listen_fd;
+		fds[nfds].events = POLLIN;
+		nfds++;
+	}
+
+	for (size_t i = 0; i < MAX_CLIENTS && nfds < max; i++) {
+		if (ipc_clients[i].fd < 0)
+			continue;
+		fds[nfds].fd = ipc_clients[i].fd;
+		fds[nfds].events = POLLIN;
+		nfds++;
+	}
+
+	return nfds;
+}
+
+static void
+ipc_handle_pollfds(const struct pollfd *fds, int nfds)
+{
+	for (int i = 0; i < nfds; i++) {
+		if (fds[i].revents == 0)
+			continue;
+
+		if (fds[i].fd == ipc_listen_fd) {
+			for (;;) {
+				int fd = accept4(ipc_listen_fd, NULL, NULL,
+						SOCK_CLOEXEC | SOCK_NONBLOCK);
+				if (fd < 0) {
+					if (errno == EINTR)
+						continue;
+					break;
+				}
+
+				struct IpcClient *slot = NULL;
+				for (size_t j = 0; j < MAX_CLIENTS; j++) {
+					if (ipc_clients[j].fd < 0) {
+						slot = &ipc_clients[j];
+						break;
+					}
+				}
+				if (slot == NULL) {
+					close(fd);
+					continue;
+				}
+
+				slot->fd = fd;
+				slot->line_len = 0;
+				ipc_broadcast_snapshot(1);
+			}
+			continue;
+		}
+
+		for (size_t j = 0; j < MAX_CLIENTS; j++)
+			if (ipc_clients[j].fd == fds[i].fd)
+				ipc_read_client(&ipc_clients[j]);
+	}
+}
+
+static void
+ipc_init(void)
+{
+	struct sigaction sa;
+
+	sigemptyset(&sa.sa_mask);
+	sa.sa_flags = 0;
+	sa.sa_handler = SIG_IGN;
+	sigaction(SIGPIPE, &sa, NULL);
+
+	for (size_t i = 0; i < MAX_CLIENTS; i++)
+		ipc_clients[i].fd = -1;
+
+	if (ipc_make_socket_path(ipc_socket_path, sizeof(ipc_socket_path)) < 0) {
+		fprintf(stderr, "pluto: cannot create IPC socket: %s\n", strerror(errno));
+		return;
+	}
+
+	ipc_listen_fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+	if (ipc_listen_fd < 0) {
+		fprintf(stderr, "pluto: IPC socket path is too long\n");
+		return;
+	}
+
+	struct sockaddr_un addr;
+	memset(&addr, 0, sizeof(addr));
+	addr.sun_family = AF_UNIX;
+	if (strlen(ipc_socket_path) >= sizeof(addr.sun_path)) {
+		fprintf(stderr, "pluto: IPC socket path is too long\n");
+		close(ipc_listen_fd);
+		ipc_listen_fd = -1;
+		return;
+	}
+	strcpy(addr.sun_path, ipc_socket_path);
+
+	unlink(ipc_socket_path);
+	if (bind(ipc_listen_fd, (struct sockaddr *)&addr, sizeof(addr)) < 0
+			|| listen(ipc_listen_fd, 4) < 0) {
+		fprintf(stderr, "pluto: cannot listen on %s: %s\n",
+				ipc_socket_path, strerror(errno));
+		close(ipc_listen_fd);
+		ipc_listen_fd = -1;
+		return;
+	}
+	chmod(ipc_socket_path, 0600);
+
+	atexit(ipc_finish);
+}
+
+static void
+ipc_finish(void)
+{
+	for (size_t i = 0; i < MAX_CLIENTS; i++)
+		ipc_close_client(&ipc_clients[i]);
+
+	if (ipc_listen_fd >= 0) {
+		close(ipc_listen_fd);
+		ipc_listen_fd = -1;
+	}
+
+	if (ipc_socket_path[0] != '\0')
+		unlink(ipc_socket_path);
+}
